{
  "schemaVersion": 1,
  "modules": [
    {
      "type": "app",
      "name": "api",
      "path": "apps/api",
      "routes": [
        {
          "path": "/"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.api",
        "target": "api"
      },
      "dev": {
        "startCommand": "python novius.py serve",
        "preStartCommands": []
      },
      "deploy": {
        "startCommand": "python novius.py serve",
        "preStartCommands": []
      }
    }
  ]
}
